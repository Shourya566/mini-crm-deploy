# Backend API Base URL
# For production (Vercel), set this to your deployed Render backend URL: https://your-backend.onrender.com
# For local development: http://localhost:3001
VITE_API_URL=http://localhost:3001

# Optional: Dedicated Auth Base URL (defaults to ${VITE_API_URL}/auth if omitted)
VITE_AUTH_URL=http://localhost:3001/auth

# Optional: Google OAuth Client ID (if needed client-side)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
