# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <your-cluster> with your Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Session & JWT Secret (Generate a secure random string for production)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# Google OAuth Configuration (Obtain from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Frontend URL & CORS Allowed Origins (Comma-separated if multiple)
# In production on Render, set these to your deployed Vercel frontend URL (e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174

# Optional: Delivery Receipt Callback URL
DELIVERY_CALLBACK_URL=http://localhost:3001/api/delivery-receipts

# Optional: OpenAI API Key for AI Segment Rule & Message Suggestions
OPENAI_API_KEY=your_openai_api_key_optional

# Local Offline Dev Auth Bypass (MUST be false in production; ignored when NODE_ENV=production)
ALLOW_DEV_AUTH_BYPASS=false
